 "tung_cau": [
  {
   "start": 0.7,
   "text": "施設の一方か30",
   "voice": "雀松朱司/ノーマル",
   "score": 0.925,
   "margin": 0.202
  },
  {
   "start": 2.6,
   "text": "分だけ手伝ってもらえないかな。",
   "voice": "雀松朱司/ノーマル",
   "score": 0.881,
   "margin": 0.187
  },
  {
   "start": 5.6,
   "text": "残業代ないんでちょっと残業する気しないっすね。",
   "voice": "黒沢冴白/ノーマル",
   "score": 0.879,
   "margin": 0.18
  },
  {
   "start": 10.9,
   "text": "この男が閉店にふ前にある嘘をつくまでの話です。",
   "voice": "玄野武宏/ノーマル",
   "score": 0.86,
   "margin": 0.052
  },
  {
   "start": 15.8,
   "text": "俺は金にならない残業はしない。この店に来てもうすぐ",
   "voice": "黒沢冴白/ノーマル",
   "score": 0.898,
   "margin": 0.199
  },
  {
   "start": 21.4,
   "text": "2年になる。契約社員で",
   "voice": "黒沢冴白/ノーマル",
   "score": 0.907,
   "margin": 0.225
  },
  {
   "start": 24.3,
   "text": "1年ごとの契約だ。更新は一した。",
   "voice": "黒沢冴白/ノーマル",
   "score": 0.906,
   "margin": 0.215
  },
  {
   "start": 28.6,
   "text": "会社が決めた給料の分だけ働く。それが",
   "voice": "黒沢冴白/ノーマル",
   "score": 0.944,
   "margin": 0.246
  },
  {
   "start": 32.2,
   "text": "1番公平なやり方だ。仕事は決められた",
   "voice": "黒沢冴白/ノーマル",
   "score": 0.935,
   "margin": 0.225
  },
  {
   "start": 36.4,
   "text": "時間の中でやる。それ以上は給料に入って",
   "voice": "黒沢冴白/ノーマル",
   "score": 0.834,
   "margin": 0.017
  },
  {
   "start": 40.5,
   "text": "いない。薬剤師は4人。店長とかベテラン",
   "voice": "玄野武宏/ノーマル",
   "score": 0.887,
   "margin": 0.075
  },
  {
   "start": 45.2,
   "text": "のパートさん。今年入った新人受付には",
   "voice": "玄野武宏/ノーマル",
   "score": 0.897,
   "margin": 0.072
  },
  {
   "start": 49.0,
   "text": "ジムさんが2人いる。店長はこの店の管理",
   "voice": "玄野武宏/ノーマル",
   "score": 0.91,
   "margin": 0.071
  },
  {
   "start": 52.4,
   "text": "薬剤師だ。彼は1年ごとに契約を",
   "voice": "玄野武宏/ノーマル",
   "score": 0.932,
   "margin": 0.048
  },
  {
   "start": 55.6,
   "text": "結ぶ薬剤師だった。締めはおばの登板ら",
   "voice": "玄野武宏/ノーマル",
   "score": 0.913,
   "margin": 0.048
  },
  {

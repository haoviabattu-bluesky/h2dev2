  {
   "start": 142.2,
   "text": "1",
   "voice": "玄野武宏/ノーマル",
   "score": 0.882,
   "margin": 0.067
  },
  {
   "start": 142.4,
   "text": "ヶ月だけ応援に行ってくれと頼まれた。車で片道",
